PORT=4000

DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/scheduler?schema=public"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Configurable knobs (see README > Architecture for what each one controls)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_LATENESS_MS=3600000
STALE_SENDING_MS=120000
MAX_RECIPIENTS_PER_CAMPAIGN=10000

# Run `npm run ethereal:create` — it prints a ready-to-paste value for this.
ETHEREAL_SENDERS=[{"user":"REPLACE_ME@ethereal.email","pass":"REPLACE_ME"}]
